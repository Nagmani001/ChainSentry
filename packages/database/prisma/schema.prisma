generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Environment {
  devnet
  testnet
  mainnet
}

enum JobStatus {
  pending
  generating
  deploying
  indexing
  live
  failed
}

model Contract {
  id          String         @id @default(cuid())
  address     String
  chainId     Int
  environment Environment
  name        String?
  abi         Json
  deployBlock BigInt?
  createdAt   DateTime       @default(now())
  deployments Deployment[]
  jobs        IngestionJob[]
  alertRules  AlertRule[]

  @@unique([address, chainId])
}

model User {
  id             String         @id @default(cuid())
  privyId        String         @unique
  email          String?
  name           String?
  phone          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  ownedOrgs      Organization[] @relation("OrgOwner")
  memberships    OrgMember[]
  onCallSlots    OnCallSlot[]
  createdRules   AlertRule[]    @relation("AlertRuleCreator")
  assignedIssues AlertIssue[]   @relation("IssueAssignee")
  resolvedIssues AlertIssue[]   @relation("IssueResolver")
  verifiedIssues AlertIssue[]   @relation("IssueVerifier")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  ownerUserId String
  owner       User         @relation("OrgOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     OrgMember[]
  onCallSlots OnCallSlot[]
  alertRules  AlertRule[]
  issues      AlertIssue[]
}

model OrgMember {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  role      String       @default("member")
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model OnCallSlot {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AlertRule {
  id          String       @id @default(cuid())
  orgId       String
  contractId  String?
  createdById String
  name        String
  metric      String
  operator    String
  threshold   Float
  windowMin   Int          @default(15)
  channel     String
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contract    Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("AlertRuleCreator", fields: [createdById], references: [id], onDelete: Cascade)
  issues      AlertIssue[]
}

model AlertIssue {
  id            String       @id @default(cuid())
  orgId         String
  ruleId        String
  assigneeId    String?
  status        String       @default("open")
  severity      String       @default("critical")
  observedValue Float
  threshold     Float
  message       String
  resolvedById  String?
  resolvedAt    DateTime?
  verifiedById  String?
  verifiedAt    DateTime?
  incentiveWei  String?
  incentiveTx   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rule          AlertRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  assignee      User?        @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  resolvedBy    User?        @relation("IssueResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  verifiedBy    User?        @relation("IssueVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
}

model Deployment {
  id                  String        @id @default(cuid())
  contractId          String
  contract            Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  prompt              String
  subgraphYaml        String
  schemaGraphql       String
  mappingsTs          String
  eventNames          String[]
  projectPath         String?
  deployStatus        String?
  deployTarget        String?
  deployMessage       String?
  queryUrl            String?
  artifactBucket      String?
  artifactPrefix      String?
  artifactManifestUrl String?
  createdAt           DateTime      @default(now())
  job                 IngestionJob?
}

model Dashboard {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  section    String   @default("metrics")
  contractId String?
  spec       Json
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model IngestionJob {
  id               String      @id @default(cuid())
  contractId       String
  contract         Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  deploymentId     String?     @unique
  deployment       Deployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  status           JobStatus   @default(pending)
  startBlock       BigInt
  lastIndexedBlock BigInt?
  targetBlock      BigInt?
  eventsIngested   Int         @default(0)
  txIngested       Int         @default(0)
  error            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}
